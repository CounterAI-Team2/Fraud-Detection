from __future__ import annotations

import html
import uuid
from datetime import datetime

from utils.constants import INSTITUTION_NAME


def make_reference_number(transaction_id: str) -> str:
    """Collision-resistant STR reference: date + transaction id + short random token."""
    d = datetime.now().strftime("%Y%m%d")
    token = uuid.uuid4().hex[:4].upper()
    return f"STR-{d}-{str(transaction_id)}-{token}"


def build_default_grounds(str_case: dict) -> str:
    shap_top3 = str_case.get("shap_top3", "")
    notes = str_case.get("investigation_notes", "")
    return (
        f"AI-driven indicators suggest suspicious behavior: {shap_top3}\n\n"
        f"Investigation notes:\n{notes}"
    )


def _row(label: str, value: str) -> str:
    return (
        f"<tr><td style='padding:6px 12px;color:#555;width:220px;"
        f"border-bottom:1px solid #eee'>{html.escape(str(label))}</td>"
        f"<td style='padding:6px 12px;border-bottom:1px solid #eee'>"
        f"{html.escape(str(value)) or '&mdash;'}</td></tr>"
    )


def build_str_document(record: dict, subject: dict | None = None, txn: dict | None = None) -> str:
    """Render a self-contained, printable HTML Suspicious Transaction Report.

    ``record`` is a persisted STR row; ``subject``/``txn`` optionally override the
    subject-particulars and transaction blocks (otherwise pulled from ``record``).
    """
    subject = subject or {}
    txn = txn or {}

    def g(key: str, default: str = "") -> str:
        return str(record.get(key, "") or subject.get(key, "") or txn.get(key, "") or default)

    reference = g("reference_number")
    generated = datetime.now().strftime("%Y-%m-%d %H:%M")
    reason_codes = g("reason_codes")

    subject_rows = "".join([
        _row("Full Name", g("subject_name")),
        _row("Date of Birth", g("subject_dob")),
        _row("Nationality", g("subject_nationality")),
        _row("ID Type", g("subject_id_type")),
        _row("ID Number", g("subject_id_number")),
        _row("Residential Address", g("subject_address")),
        _row("Customer ID", g("customer_id")),
    ])
    txn_rows = "".join([
        _row("Transaction Reference", g("transaction_id")),
        _row("Case ID", g("case_id")),
        _row("Amount / Currency", f"{txn.get('amount', '')} {g('currency')}".strip()),
        _row("Sender Account", str(txn.get("sender_account", ""))),
        _row("Receiver Account", str(txn.get("receiver_account", ""))),
        _row("Payment Method", str(txn.get("payment_type", ""))),
        _row("Date of Transaction", str(txn.get("date", ""))),
    ])
    review_rows = "".join([
        _row("Drafted by", f"{g('drafted_by')}  ({g('drafted_role')})"),
        _row("L1 Reviewer", f"{g('l1_reviewer')}  ({g('l1_role')})  {g('l1_reviewed_at')}"),
        _row("L2 Reviewer", f"{g('l2_reviewer')}  ({g('l2_role')})  {g('l2_reviewed_at')}"),
        _row("Status", g("status")),
    ])

    grounds_html = html.escape(g("grounds")).replace("\n", "<br>")

    return f"""<!DOCTYPE html>
<html lang="en"><head><meta charset="UTF-8"/>
<title>STR {html.escape(reference)}</title></head>
<body style="font-family:Arial,Helvetica,sans-serif;color:#222;max-width:820px;margin:24px auto;font-size:14px;">
  <div style="border-bottom:3px solid #1a3c6e;padding-bottom:12px;margin-bottom:18px;">
    <div style="font-size:20px;font-weight:700;color:#1a3c6e;">Suspicious Transaction Report</div>
    <div style="color:#666;">{html.escape(INSTITUTION_NAME)}</div>
    <div style="color:#888;font-size:12px;margin-top:4px;">
      Reference: <b>{html.escape(reference)}</b> &middot; Generated: {generated}</div>
  </div>

  <h3 style="color:#1a3c6e;font-size:14px;border-bottom:1px solid #ddd;padding-bottom:4px;">Subject Particulars</h3>
  <table style="width:100%;border-collapse:collapse;margin-bottom:18px;">{subject_rows}</table>

  <h3 style="color:#1a3c6e;font-size:14px;border-bottom:1px solid #ddd;padding-bottom:4px;">Transaction Details</h3>
  <table style="width:100%;border-collapse:collapse;margin-bottom:18px;">{txn_rows}</table>

  <h3 style="color:#1a3c6e;font-size:14px;border-bottom:1px solid #ddd;padding-bottom:4px;">Reason Codes</h3>
  <p style="margin:6px 0 18px;">{html.escape(reason_codes) or '&mdash;'}</p>

  <h3 style="color:#1a3c6e;font-size:14px;border-bottom:1px solid #ddd;padding-bottom:4px;">Grounds for Suspicion</h3>
  <p style="margin:6px 0 18px;line-height:1.6;">{grounds_html or '&mdash;'}</p>

  <h3 style="color:#1a3c6e;font-size:14px;border-bottom:1px solid #ddd;padding-bottom:4px;">Maker&ndash;Checker Trail</h3>
  <table style="width:100%;border-collapse:collapse;">{review_rows}</table>

  <p style="color:#999;font-size:11px;margin-top:24px;border-top:1px solid #eee;padding-top:10px;">
    This report was generated by the CounterAI AML platform for filing purposes.</p>
</body></html>"""